# Application
NODE_ENV=development
DATABASE_PATH=./data/mandate.db
APP_BASE_URL=http://localhost:3000

# Money / policy caps (integer minor units unless noted)
MAX_ORDER_TOTAL_MINOR=100000000
MAX_UNIT_PRICE_MINOR=10000000
MAX_QUANTITY=100000
APPROVAL_TTL_SECONDS=86400

# Auth0 (nextjs-auth0 v4 + Organizations)
# Domain has no scheme. Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://mandate.local/api
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
# Fallback human permissions when access token has no RBAC permissions claim
AUTH0_DEFAULT_HUMAN_PERMISSIONS=mandates:write,approvals:read,approvals:decide,orders:read
# Comma-separated M2M client_id=org_auth0_id mappings (fallback when org_id claim absent)
AUTH0_M2M_CLIENT_ORG_MAP=buyer_client_id=org_buyer,supplier_a_client_id=org_supplier_a
# Test-only HMAC agent tokens + mandate_session cookie (never enable in production)
AUTH_TEST_MODE=0
SESSION_SECRET=replace-with-32+-byte-random-string

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_PAYMENT_METHOD=pm_card_visa

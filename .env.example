# Local SQLite database. One Node process only.
DATABASE_PATH=.data/mandate.db

# Auth0 tenant and application settings.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Stripe test-mode settings. The webhook secret comes from Stripe CLI locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=

# Pooled runtime URL and unpooled migration URL from Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth0 tenant and application settings.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Real Auth0 login plus local demo organization/permissions. Ignored in production.
LOCAL_DEMO_AUTHZ=false

# Existing Auth0 organization IDs used by the deterministic demo seed.
AUTH0_BUYER_ORG_ID=
AUTH0_GREENLINE_ORG_ID=
AUTH0_SUNCREST_ORG_ID=
AUTH0_ORCHARD_ORG_ID=

# Stripe test-mode settings. The webhook secret comes from Stripe CLI locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=
